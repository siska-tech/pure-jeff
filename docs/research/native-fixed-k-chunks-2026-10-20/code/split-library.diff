+/// With 4 or more compute threads and at least 512 rows, the blocks `matmul` gives the threads:
+/// `(product, (row0, rows), (col0, cols))`. The output of each of the `batch` products is split
+/// along its larger side into about `threads / batch` parts of whole 16s, at least 64 long.
+/// The blocks are disjoint and cover every output element once. None (gemm then splits each
+/// chunk among the threads itself) for fewer threads or rows, when that gives fewer than two
+/// blocks, or when a block would make gemm take another path than for the whole product,
+/// adding in another order: m x n <= 256 (its horizontal kernels) or a side of 1 (gemv).
+#[cfg(feature = "native")]
+#[allow(clippy::type_complexity)]
+fn out_blocks(
+    batch: usize,
+    m: usize,
+    n: usize,
+    threads: usize,
+) -> Option<Vec<(usize, (usize, usize), (usize, usize))>> {
+    if threads < 4 || m < 512 || batch == 0 {
+        return None;
+    }
+    let along_rows = m >= n;
+    let len = if along_rows { m } else { n };
+    let parts = threads.div_ceil(batch).min(len / 64).max(1);
+    let per = len.div_ceil(16).div_ceil(parts).max(1) * 16;
+    let split: Vec<(usize, usize)> = (0..len)
+        .step_by(per)
+        .map(|start| (start, per.min(len - start)))
+        .collect();
+    let blocks: Vec<_> = (0..batch)
+        .flat_map(|step| {
+            split.iter().map(move |&part| {
+                if along_rows {
+                    (step, part, (0, n))
+                } else {
+                    (step, (0, m), part)
+                }
+            })
+        })
+        .collect();
+    let same_path = blocks
+        .iter()
+        .all(|&(_, (_, rows), (_, cols))| rows >= 2 && cols >= 2 && rows * cols > 256);
+    (blocks.len() >= 2 && same_path).then_some(blocks)
+}
