+/// `matmul`'s output buffer, shared by the threads that write its blocks.
+#[derive(Clone, Copy)]
+struct Output(*mut f32);
+
+// SAFETY: the threads of one `matmul` write disjoint blocks of the output (`out_blocks`) and
+// read nothing through this pointer; the buffer outlives them, and nothing else touches it
+// until the parallel loop has joined.
+#[cfg(feature = "native")]
+unsafe impl Send for Output {}
+#[cfg(feature = "native")]
+unsafe impl Sync for Output {}
+
+impl Output {
+    /// The output pointer `offset` elements in. Callers stay inside the buffer (see `matmul`).
+    fn at(self, offset: usize) -> *mut f32 {
+        self.0.wrapping_add(offset)
+    }
+}
